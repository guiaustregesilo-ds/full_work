table f_cotacoes
	lineageTag: a215e374-e817-4382-a30f-5a0436edcabd

	measure 'Cotação do dia' = ```
			AVERAGE(f_cotacoes[Cotacao]) 
			```
		displayFolder: Medida
		lineageTag: c43b25d5-ed82-452a-98b2-50cee440394d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cotação corrigida' = ```
			
			
			VAR __DataCtx = MAX(d_calendario[Data]) 
			
			VAR __UltimaDataComCotacao = 
			    CALCULATE(
			        LASTNONBLANK(d_calendario[Data], [Cotação do dia]),
			        d_calendario[Data] <= __DataCtx
			    )
			
			RETURN
			    CALCULATE(
			        [Cotação do dia],
			       d_calendario[Data] = __UltimaDataComCotacao
			    )
			```
		displayFolder: Medida
		lineageTag: 87474f82-6802-4935-94e0-44693c2bcde2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

